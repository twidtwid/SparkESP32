[Unit]
Description=SparkESP32 - DGX Spark vitals feed for the ESP32 status display
Documentation=https://github.com/twidtwid/SparkESP32
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own unprivileged user, which systemd makes for as long as the service runs. Nobody's
# login account: nothing else on the Spark runs as it, so nothing else can read what the
# agent holds (a Sparkline token, below).
DynamicUser=yes
# serial access to the display
SupplementaryGroups=dialout
# written by install.sh only when a Sparkline agent runs here: its URL and token
EnvironmentFile=-/etc/sparkesp32/sparkline.env
# written by install.sh --only-this-display: the one USB device the agent opens
EnvironmentFile=-/etc/sparkesp32/display.env
ExecStart=/opt/sparkesp32/venv/bin/python -I /opt/sparkesp32/sparkesp32_agent.py
Restart=always
RestartSec=3

# The agent only reads /proc, runs nvidia-smi (or asks Sparkline), opens one tty and one socket.
# So: nothing to write to, no home directories, no privileges to gain or to keep, only the
# system calls an ordinary service makes, and only IP, Unix and netlink sockets (the last two
# for nvidia-smi and the C library). Check it with `systemd-analyze security sparkesp32`.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# a handful of threads and one nvidia-smi: a bound, in case something runs away
TasksMax=64
# Left out on purpose: PrivateDevices=, DeviceAllow= and ProtectClock= (which adds a
# DeviceAllow= rule). Each hides device nodes the agent needs: the display's tty, /dev/nvidia*.
# Who may talk to the agent, firewall or not: this host, and the subnets install.sh puts
# here (this host's own, and --lan). It drops both lines when it can't tell the subnet;
# then only a firewall limits who reaches the agent.
IPAddressDeny=any
IPAddressAllow=localhost @LAN@

[Install]
WantedBy=multi-user.target
