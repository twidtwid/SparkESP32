[Unit]
Description=SparkESP32 - DGX Spark vitals feed for the ESP32 status display
Documentation=https://github.com/twidtwid/SparkESP32
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own unprivileged user, which systemd makes for as long as the service runs. Nobody's
# login account: nothing else on the Spark runs as it, so nothing else can read what the
# agent holds (a Sparkline token, below).
DynamicUser=yes
# serial access to the display
SupplementaryGroups=dialout
# written by install.sh only when a Sparkline agent runs here: its URL and token
EnvironmentFile=-/etc/sparkesp32/sparkline.env
# written by install.sh once it has seen the display: the one USB device the agent opens
EnvironmentFile=-/etc/sparkesp32/display.env
ExecStart=/opt/sparkesp32/venv/bin/python /opt/sparkesp32/sparkesp32_agent.py
Restart=always
RestartSec=3

# the agent only reads /proc, runs nvidia-smi (or asks Sparkline), opens one tty and one socket
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Who may talk to the agent, firewall or not: this host, and the subnets install.sh puts
# here (this host's own, and --lan). It drops both lines when it can't tell the subnet;
# then only a firewall limits who reaches the agent.
IPAddressDeny=any
IPAddressAllow=localhost @LAN@

[Install]
WantedBy=multi-user.target
