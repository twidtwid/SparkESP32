# Waveshare ESP32-C6-Touch-AMOLED-2.16: ESP32-C6, 16 MB flash, no PSRAM
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/waveshare-esp32c6-amoled-2.16/partitions.csv"

# console on the native USB-Serial/JTAG port (the agent's USB transport)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
