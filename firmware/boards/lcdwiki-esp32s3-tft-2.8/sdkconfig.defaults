# LCDWiki 2.8inch ESP32-S3 Display (ES3C28P): ESP32-S3 N16R8, 16 MB flash and 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/lcdwiki-esp32s3-tft-2.8/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# console on the native USB-Serial/JTAG port (the agent's USB transport)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# the 320x240 layout's title and ring values, and the small line under each value
# (firmware/main/ui.c)
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_12=y
