# Elecrow CrowPanel ESP32 5.79" E-Paper: ESP32-S3 (S3R8) with 8 MB flash and 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/elecrow-esp32s3-epaper-5.79/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The USB-C port goes through a CH340 USB-UART bridge to UART0, not to the chip's own
# USB, so the console (the agent's USB transport) is UART0 at its default 115200 baud.
# Faster (921600) lost data on Linux's CH340 driver; the feed needs ~200 bytes a second.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# the wide layout's ring values and readouts
CONFIG_LV_FONT_MONTSERRAT_36=y
