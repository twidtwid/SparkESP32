# Elecrow CrowPanel ESP32 5.79" E-Paper: ESP32-S3 (S3R8) with 8 MB flash and 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/elecrow-esp32s3-epaper-5.79/partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The USB-C port goes through a CH340 USB-UART bridge to UART0, not to the chip's own
# USB, so the console (the agent's USB transport) is UART0, on its usual pins, at the
# 921600 baud the agent and tools open: a screenshot (~575 KB of base64) takes about
# 7 s. Only a "custom" UART console takes a baud rate other than 115200.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# the wide layout's ring values and readouts
CONFIG_LV_FONT_MONTSERRAT_36=y
