# SparkESP32: settings shared by every board. Each board adds its own (chip,
# flash, partitions, console, PSRAM) in boards/<id>/sdkconfig.defaults.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi: static TX buffers, no GCMP; wider TCP window absorbs RX stalls
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_GMAC_SUPPORT=n
CONFIG_LWIP_TCP_WND_DEFAULT=11520

# LVGL 9: a 64 KB built-in pool (in .bss), the fonts the UI uses
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
